<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yd_page_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/watchToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/yd_accent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:text="@string/strategy4_mode_watch"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/watchTabSegmentBar"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_follow_sort_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/watchTabFollowBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_follow_sort_seg_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="28dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/follow_panel_title"
                    android:textColor="@color/yd_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/watchTabBkBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_follow_sort_seg_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="28dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/strategy4_tab_sector"
                    android:textColor="@color/yd_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/watchTabLimitUpBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_follow_sort_seg_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="28dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/strategy4_tab_limit_up_pool"
                    android:textColor="@color/yd_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/watchTabUnusualBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_follow_sort_seg_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="28dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/strategy4_tab_unusual"
                    android:textColor="@color/yd_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/watchToolbarRefreshBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/strategy4_refresh"
                android:padding="8dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="@android:color/white" />
        </FrameLayout>
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/watchFragmentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/yd_page_bg" />

</LinearLayout>
