<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#333"
    android:minWidth="220dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/followBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="关注"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/stickyOnTopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="置顶"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/stickyOnBottomBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="置底"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/markColorBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="标色"
        android:textColor="#fff"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/colorPaletteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/palettePick1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/palettePick5"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick6"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick7"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick8"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/palettePick9"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick10"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick11"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/palettePick12"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="8dp"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:visibility="gone"
        android:id="@+id/expandReasonBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="展开涨停原因"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:visibility="gone"
        android:id="@+id/expandPOPReasonBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="展开热度解释"
        android:textColor="#fff"
        android:textSize="18sp" />


    <TextView
        android:id="@+id/relatedConceptBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="概念板块"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dragonTigerRankBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="龙虎榜"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/joinBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="自定义板块"
        android:textColor="#fff"
        android:textSize="18sp" />


    <TextView
        android:id="@+id/ydHistoryBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="异动历史"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/strongLinkStocksBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="关联股票"
        android:textColor="#fff"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/stockFitRankingBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="走势拟合"
        android:textColor="#fff"
        android:textSize="18sp" />



</LinearLayout>